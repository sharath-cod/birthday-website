# Server
PORT=5000
NODE_ENV=development
# Website origin(s), comma-separated, no trailing slash. "*" wildcard allowed, e.g. https://my-app-*.vercel.app
# The Android app's origins are built in; do not add them.
CLIENT_URL=http://localhost:5173

# MongoDB (local default shown; use your Atlas free-tier URI for cloud)
MONGO_URI=mongodb://127.0.0.1:27017/student_career_tracker

# JWT - generate a long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used ONLY by `npm run seed:admin`
ADMIN_NAME=College Admin
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=

# Shown at the top of PDF reports
COLLEGE_NAME=Your Engineering College

# Certificate file storage: Cloudinary free tier (Dashboard -> Settings -> API Keys).
# Leave all three empty to keep files inside MongoDB (fine for local testing only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional rate-limit tuning (per IP, per 15 minutes). Defaults suit a college network.
# RATE_LIMIT_MAX=6000
# AUTH_RATE_LIMIT_MAX=600
