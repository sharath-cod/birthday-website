# ============================================================
# EduComm Backend v2 — Environment Variables
# Copy to .env and fill in your real values
# NEVER commit .env to GitHub!
# ============================================================

# MySQL Database (Railway provides this)
DB_HOST=your-service.aivencloud.com
DB_PORT=19174
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_SSL=true

# GitHub Bot (for code file versioning & audit logs)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_ORG=your-github-username
GITHUB_REPO=educomm-files

# JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_256bit_random_hex
JWT_REFRESH_SECRET=replace_with_another_256bit_random_hex

# Code Runner (Piston API — free, no key needed)
PISTON_URL=https://emkc.org/api/v2/piston

# Server
PORT=3001
NODE_ENV=production

# Frontend URL for CORS (your GitHub Pages domain)
FRONTEND_URL=https://yourusername.github.io

# Admin emails — pre-approved on first registration
ADMIN_EMAILS=admin@yourinstitute.edu
